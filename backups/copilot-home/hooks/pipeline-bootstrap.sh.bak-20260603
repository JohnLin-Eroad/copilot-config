#!/usr/bin/env bash
# pipeline-bootstrap.sh — userPromptSubmitted hook
#
# Deterministically initialises the STM on the first non-trivial user prompt
# of every session, then injects STM_PATH + pipeline bookend reminders into
# the model's additionalContext. Subsequent prompts get a lightweight reminder.
#
# Input (stdin JSON): {sessionId, timestamp, cwd, prompt}
# Output (stdout JSON): {additionalContext: "..."}
#
# Failure mode: if anything goes wrong, exit 0 with empty output. Never block
# the user's prompt because of a hook error.

set -u

LOG="$HOME/.copilot/logs/pipeline-bootstrap.log"
mkdir -p "$(dirname "$LOG")"

INPUT=$(cat)
SESSION_ID=$(echo "$INPUT" | jq -r '.sessionId // empty')
PROMPT=$(echo "$INPUT" | jq -r '.prompt // empty')

# Guard rails — never crash the turn
if [[ -z "$SESSION_ID" || -z "$PROMPT" ]]; then
  echo "{}"
  exit 0
fi

SESSION_DIR="$HOME/.copilot/session-state/$SESSION_ID"
MARKER="$SESSION_DIR/stm-path.txt"
mkdir -p "$SESSION_DIR"

# ── Skip-trivial filter ────────────────────────────────────────────────────
# Don't bootstrap STM for:
#   - slash commands (/help, /context, /model, etc.)
#   - very short prompts (greetings, confirmations)
#   - pure questions that won't produce artifacts
trivial_prompt() {
  local p="$1"
  # Slash commands
  [[ "$p" == /* ]] && return 0
  # Shell-passthrough
  [[ "$p" == !* ]] && return 0
  # Too short
  [[ ${#p} -lt 25 ]] && return 0
  # Common confirmation patterns
  case "$(echo "$p" | tr '[:upper:]' '[:lower:]')" in
    "continue"|"yes"|"ok"|"go"|"proceed"|"do it"|"sounds good"|"thanks"|"good job"|"nice")
      return 0 ;;
  esac
  return 1
}

# ── Branch 1: STM already initialised — light-touch reminder ───────────────
if [[ -f "$MARKER" ]]; then
  STM_PATH=$(cat "$MARKER")
  if [[ -f "$STM_PATH" ]]; then
    # Detect whether the orchestrator ever wrote to STM since init.
    # entry_count is the # of agent contribution entries; if zero and the STM
    # is > 60s old, the pipeline almost certainly stalled at step 1.
    STM_AGE_S=$(( $(date +%s) - $(stat -f %m "$STM_PATH" 2>/dev/null || echo 0) ))
    HAS_AGENT_WRITES=$(grep -c "^### " "$STM_PATH" 2>/dev/null; true)
    HAS_AGENT_WRITES=${HAS_AGENT_WRITES%%$'\n'*}
    HAS_CLASSIFICATION=$(grep -c "^  Domain:     eroad\|^  Domain:     personal" "$STM_PATH" 2>/dev/null; true)
    HAS_CLASSIFICATION=${HAS_CLASSIFICATION%%$'\n'*}

    REMINDER="📋 STM_PATH=$STM_PATH (already initialised — do NOT re-init).
Append progress: bash ~/.copilot/scripts/write-stm.sh \"\$STM_PATH\" \"<agent>\" \"STATUS: ...\""

    if [[ "$HAS_CLASSIFICATION" == "0" && $STM_AGE_S -gt 60 ]]; then
      REMINDER="$REMINDER

⚠️ PIPELINE STALL: STM was created but Classification block is still empty.
You skipped Step 2 of the orchestrator protocol. Before continuing:
  1. Fill in ## [STM] Task Brief → Classification (Domain / Type / Blast / Pipeline / BRAIN_TYPE)
  2. If this is an EROAD task (Domain: eroad), invoke brain-data-retrieval NOW with STM_PATH
  3. Then route to the correct specialist agent (never general-purpose — use agent-factory if no fit)"
    elif [[ "$HAS_AGENT_WRITES" == "0" && $STM_AGE_S -gt 120 ]]; then
      REMINDER="$REMINDER

⚠️ No agent contributions written to STM yet. If specialist work has occurred,
call write-stm.sh for each contribution so the dashboard and brain-consolidation can see it."
    fi

    jq -n --arg ctx "$REMINDER" '{additionalContext: $ctx}'
    echo "$(date -u +%FT%TZ) [reminder] session=$SESSION_ID stm=$STM_PATH age=${STM_AGE_S}s class=$HAS_CLASSIFICATION writes=$HAS_AGENT_WRITES" >> "$LOG"
    exit 0
  else
    # Stale marker — clear it and fall through
    rm -f "$MARKER"
  fi
fi

# ── Branch 2: trivial prompt — no STM yet, no init ─────────────────────────
if trivial_prompt "$PROMPT"; then
  echo "{}"
  echo "$(date -u +%FT%TZ) [skip-trivial] session=$SESSION_ID prompt='${PROMPT:0:60}'" >> "$LOG"
  exit 0
fi

# ── Branch 3: first real prompt — initialise STM deterministically ─────────
# Truncate prompt for the slug
TASK_DESC=$(echo "$PROMPT" | head -c 200)

INIT_OUT=$(python3 "$HOME/.copilot/scripts/stm-init.py" --no-open "$TASK_DESC" 2>>"$LOG")
INIT_RC=$?
if [[ $INIT_RC -ne 0 ]]; then
  echo "$(date -u +%FT%TZ) [init-failed] session=$SESSION_ID rc=$INIT_RC" >> "$LOG"
  echo "{}"
  exit 0
fi

STM_PATH=$(echo "$INIT_OUT" | grep '^STM_PATH=' | head -1 | cut -d= -f2-)
STM_DIR=$(echo "$INIT_OUT" | grep '^STM_DIR=' | head -1 | cut -d= -f2-)

if [[ -z "$STM_PATH" || ! -f "$STM_PATH" ]]; then
  echo "$(date -u +%FT%TZ) [init-no-stm-path] session=$SESSION_ID out='$INIT_OUT'" >> "$LOG"
  echo "{}"
  exit 0
fi

# Persist marker for subsequent turns
echo "$STM_PATH" > "$MARKER"
echo "$STM_DIR" > "$SESSION_DIR/stm-dir.txt"

# Build the bootstrap additionalContext — directive, inlines orchestrator's 4-step protocol
BOOTSTRAP=$(cat <<EOF
🧠 PIPELINE BOOTSTRAP — You are the orchestrator. STM has been auto-initialised.

STM_PATH=$STM_PATH
STM_DIR=$STM_DIR

═══ MANDATORY 4 STEPS — do these BEFORE any specialist work ═══

STEP 1 — Read STM_PATH (already in this context — no need to cat).

STEP 2 — Classify the task. Write this block into ## [STM] Task Brief using write-stm.sh:

  Classification:
    Domain:     eroad | personal
    Type:       code-change | architecture | discovery | documentation | research | question | ops | general
    Blast:      LOW | MEDIUM | HIGH | CRITICAL
    Pipeline:   minimal | standard | full-transformation
    BRAIN_TYPE: eroad | personal

  Domain heuristic: eroad = EROAD/Sovereign/services/RUCUS/NZ-AU transport, media-service, any DRP-* ticket.
                    personal = copilot config, AI/benchmarking, personal projects.

STEP 3 — If Domain=eroad OR Pipeline≠minimal, invoke brain-data-retrieval NOW with STM_PATH.
  No exceptions for EROAD tasks — stale context produces worse output than a small delay.

STEP 4 — Route to a specialist agent (developer / qa-engineer / architect / etc.).
  If no agent fits, invoke agent-factory. NEVER use general-purpose as a fallback
  (only legal uses: unstick skill, benchmark-runner grader).

═══ WHILE WORKING ═══

After each major step, append to STM:
  bash ~/.copilot/scripts/write-stm.sh "\$STM_PATH" "<agent-name>" "STATUS: <short summary>"

At task end:
  - Invoke brain-consolidation to persist learnings into the SQL brain.
  - Run bash ~/.copilot/scripts/add-learning.sh --local|--global if a non-obvious pattern emerged.

═══ TRIVIAL ESCAPE HATCH ═══

If on reflection the task is genuinely trivial (LOW blast, no files written, pure Q&A, single one-liner),
say so once in your first reply and you may skip Steps 3–4. Step 2 (Classification) is still required —
it takes 5 seconds and proves you read this and made a deliberate choice.

Do NOT call stm-init.py — the STM already exists at the path above.
EOF
)

jq -n --arg ctx "$BOOTSTRAP" '{additionalContext: $ctx}'
echo "$(date -u +%FT%TZ) [init-ok] session=$SESSION_ID stm=$STM_PATH" >> "$LOG"
exit 0
