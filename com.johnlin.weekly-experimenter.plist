<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.johnlin.weekly-experimenter</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/johnlin/.copilot/scripts/weekly-branch.sh</string>
  </array>

  <!-- Every Sunday at 10:00 (1 hour after ai-learner) -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>10</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/johnlin/.copilot/logs/weekly-experimenter.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/johnlin/.copilot/logs/weekly-experimenter.stderr.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
