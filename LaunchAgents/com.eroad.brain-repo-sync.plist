<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.eroad.brain-repo-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/johnlin/.copilot/scripts/brain-repo-sync.sh</string>
  </array>

  <!-- Run every 24 hours after last run — fires on wake if interval has elapsed -->
  <key>StartInterval</key>
  <integer>86400</integer>

  <key>StandardOutPath</key>
  <string>/tmp/brain-repo-sync.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/brain-repo-sync.log</string>

  <!-- Don't run immediately on load/login -->
  <key>RunAtLoad</key>
  <false/>

</dict>
</plist>
