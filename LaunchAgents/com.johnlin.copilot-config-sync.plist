<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.johnlin.copilot-config-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/johnlin/.copilot/scripts/watch-config.sh</string>
    </array>

    <!-- Start immediately and restart if it ever exits -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- Log output to ~/.copilot/logs/ -->
    <key>StandardOutPath</key>
    <string>/Users/johnlin/.copilot/logs/watch-config.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/johnlin/.copilot/logs/watch-config.log</string>
</dict>
</plist>
